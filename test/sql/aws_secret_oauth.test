# name: test/sql/aws_secret_oauth.test
# description: CREATE SECRET (PROVIDER oauth): the argument checks and the code-paste handshake, nothing reaches AWS
# group: [sql]

require aws

require httpfs

statement ok
LOAD aws

# The region of the Sign-In endpoint is required, for every mode.
statement error
CREATE SECRET a (TYPE aws, PROVIDER oauth);
----
REGION is required

statement error
CREATE SECRET a (TYPE s3, PROVIDER oauth, MODE 'code');
----
REGION is required

statement error
CREATE SECRET a (TYPE aws, PROVIDER oauth, REGION 'us-east-1', MODE 'telepathy');
----
MODE must be 'browser' (default) or 'code'

statement error
CREATE SECRET a (TYPE aws, PROVIDER oauth, REGION 'us-east-1', REFRESH 'sometimes');
----
REFRESH must be 'auto' (default) or 'none'

# A pasted code is base64 of 'state=...&code=...', and must belong to a sign-in this process started.
statement error
CREATE SECRET a (TYPE aws, PROVIDER oauth, REGION 'us-east-1', CODE '%%% not base64');
----
CODE is not the code AWS Sign-In showed

statement error
CREATE SECRET a (TYPE aws, PROVIDER oauth, REGION 'us-east-1', CODE 'bm90aGluZw==');
----
CODE is missing its state or authorization code

statement error
CREATE SECRET a (TYPE aws, PROVIDER oauth, REGION 'us-east-1', CODE 'c3RhdGU9eCZjb2RlPXk=');
----
belongs to no sign-in started in this process

# MODE 'code' hands back the authorization URL: the cross-device client, PKCE with SHA-256, a state, the openid
# scope and Sign-In's own confirmation page as redirect. The statement itself does not create a secret yet.
statement error
CREATE SECRET a (TYPE aws, PROVIDER oauth, REGION 'eu-west-1', MODE 'code');
----
<REGEX>:.*https://eu-west-1\.signin\.aws\.amazon\.com/v1/authorize\?response_type=code&client_id=arn%3Aaws%3Asignin%3A%3A%3Adevtools%2Fcross-device&state=[0-9a-f-]{36}&code_challenge_method=SHA-256&code_challenge=[A-Za-z0-9_-]{43}&scope=openid&redirect_uri=https%3A%2F%2Feu-west-1\.signin\.aws\.amazon\.com%2Fv1%2Fsessions%2Fconfirmation.*

# Another OAuth client can be named.
statement error
CREATE SECRET a (TYPE aws, PROVIDER oauth, REGION 'us-east-1', MODE 'code', CLIENT 'arn:aws:signin:::devtools/duckdb-testing');
----
<REGEX>:.*https://us-east-1\.signin\.aws\.amazon\.com/v1/authorize\?response_type=code&client_id=arn%3Aaws%3Asignin%3A%3A%3Adevtools%2Fduckdb-testing&.*

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'a';
----
0
